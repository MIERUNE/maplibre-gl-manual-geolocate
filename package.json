{
  "name": "@mierune/maplibre-gl-manual-geolocate",
  "version": "1.0.0",
  "description": "A MapLibre GL JS control that displays a user position marker at specified coordinates without requiring the browser's geolocation API",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "author": "MIERUNE Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MIERUNE/maplibre-gl-manual-geolocate.git"
  },
  "homepage": "https://maplibre-gl-manual-geolocate.mierune.dev/",
  "bugs": {
    "url": "https://github.com/MIERUNE/maplibre-gl-manual-geolocate/issues"
  },
  "keywords": [
    "maplibre",
    "maplibre-gl"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "module": "./dist/maplibre-gl-manual-geolocate.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/maplibre-gl-manual-geolocate.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --config vite.config.lib.ts",
    "build:demo": "vite build --config vite.config.demo.ts",
    "preview": "vite preview",
    "preview:demo": "vite preview --config vite.config.demo.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "pnpm@10.34.7",
  "peerDependencies": {
    "maplibre-gl": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@microsoft/api-extractor": "^7.59.4",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "maplibre-gl": "^6.14.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,css,html}": "biome check --write --no-errors-on-unmatched"
  }
}
